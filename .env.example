# Copy to .env for local development. On Railway these are service variables.

# Postgres in production (docker-compose.yml gives one on port 5434). Leave unset for a local SQLite demo.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5434/bide_followup
TIMEZONE=Europe/London

# Public URL of the web app; OAuth callbacks and links in Slack point here.
APP_BASE_URL=http://localhost:5175
# Outside localhost the API won't start without SESSION_SECRET and TOKEN_ENCRYPTION_KEY.
SESSION_SECRET=change-me
# Local only: sign in by email without Google (ignored unless APP_BASE_URL is localhost).
AUTH_DEV_LOGIN=true
# Domains that count as internal and may sign in, comma-separated.
BIDE_DOMAINS=bidehotels.com,liddellpropertyinvestments.com

# Encrypts stored OAuth tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Bide Hub single sign-on. With all three set, the sign-in page offers "Sign in with Bide" instead of Google; leave
# any of them empty to keep signing in as before. Registered on the Hub with redirect URI
# <APP_BASE_URL>/api/auth/bide/callback and back-channel logout URI <APP_BASE_URL>/api/auth/bide/backchannel-logout.
# Dev: http://localhost:5190, meeting-followup, dev-secret-meeting-followup.
BIDE_HUB_ISSUER=
BIDE_HUB_CLIENT_ID=
BIDE_HUB_CLIENT_SECRET=
# true: Bide Hub manages who has an account and with which role (needs the three above). See README.
BIDE_HUB_MANAGES_ACCOUNTS=false

# Google OAuth app, Internal to the Bide Workspace. Authorised redirect URIs:
#   <APP_BASE_URL>/api/auth/google/callback          (sign-in)
#   <APP_BASE_URL>/api/auth/google/connect/callback  (connecting David's account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack app (slack/manifest.yaml). Installed from Admin → Connections.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
ADMIN_ALERT_SLACK_CHANNEL=

# Claude (PRD decision D1): "api" calls the Claude API with ANTHROPIC_API_KEY; "routine" queues requests for a
# scheduled Claude Code routine on Bide's Claude plan, which calls the service API with SERVICE_API_TOKEN
# (routine/README.md). Without the key or token, meetings wait in the queue.
EXTRACTION_MODE=api
SERVICE_API_TOKEN=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Wispr Flow's voice API (exclusive access: ask enterprise@wisprflow.ai). With a key, the boxes people write in get a
# microphone button. Without one, Wispr Flow still works as a dictation app on David's computer and phone.
WISPR_API_KEY=

POLL_INTERVAL_MINUTES=10
