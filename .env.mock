# The app wired to the local mock services (apps/api/mocks). No secrets here: every value is a mock.
# pnpm dev:mocks, then pnpm dev:api:mock (and pnpm dev:worker:mock to run the schedule).
DATABASE_URL=sqlite:///./followup-mock.db
APP_BASE_URL=http://localhost:5175
SESSION_SECRET=mock-session-secret
AUTH_DEV_LOGIN=true
TOKEN_ENCRYPTION_KEY=GWmQp9agRfAHQEAtCXZ-89erxQd96XfnBVPR0nDj0_s=

# Empty, so the sign-in page hides "Sign in with Google" (Google's real sign-in can't use a mock client) and these
# override the real values in .env. The pretend Google connection from seed:mock refreshes against the mock.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_URL=http://localhost:8400/google/token
GOOGLE_API_URL=http://localhost:8400/google

ANTHROPIC_API_KEY=mock-key
ANTHROPIC_BASE_URL=http://localhost:8400/anthropic
GMAIL_API_URL=http://localhost:8400/gmail
SLACK_API_URL=http://localhost:8400/slack/api
ADMIN_ALERT_SLACK_CHANNEL=C0ALERTS
